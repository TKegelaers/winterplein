@page "/seasons/{Id:int}"
@using Winterplein.Application.IO.DTOs
@inject SeasonApiClient SeasonApi
@inject PlayerApiClient PlayerApi
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

@if (_loading)
{
    <MudSkeleton />
}
else if (_season == null)
{
    <MudAlert Severity="Severity.Error">Season not found.</MudAlert>
}
else
{
    <div class="d-flex align-center justify-space-between mb-4">
        <MudText Typo="Typo.h5">@_season.Name</MudText>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit"
                   OnClick="@(() => Navigation.NavigateTo($"/seasons/{Id}/edit"))">
            Edit
        </MudButton>
    </div>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText><strong>Weekday:</strong> @_season.Weekday</MudText>
                <MudText><strong>Period:</strong> @_season.StartDate.ToShortDateString() – @_season.EndDate.ToShortDateString()</MudText>
                <MudText><strong>Time:</strong> @_season.StartHour.ToString("HH:mm") – @_season.EndHour.ToString("HH:mm")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText><strong>Matchdays:</strong> @_season.MatchdayCount</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mb-2">Matchdays</MudText>
    @if (_season.Matchdays.Count == 0)
    {
        <MudText Color="Color.Secondary" Class="mb-4">No matchdays in this period.</MudText>
    }
    else
    {
        <MudTable Items="_season.Matchdays" Hover="true" Dense="true" Class="mb-4">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>Date</MudTh>
                <MudTh>Day</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@(_season.Matchdays.IndexOf(context) + 1)</MudTd>
                <MudTd>@context.ToShortDateString()</MudTd>
                <MudTd>@context.DayOfWeek</MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudText Typo="Typo.h6" Class="mb-2">Players</MudText>

    <div class="d-flex align-center gap-2 mb-3">
        <MudSelect T="PlayerDto" @bind-Value="_selectedPlayer" Label="Add player"
                   ToStringFunc="@(p => p == null ? "" : $"{p.FirstName} {p.LastName}")"
                   Dense="true" Style="max-width: 300px;">
            @foreach (var player in _availablePlayers)
            {
                <MudSelectItem Value="player">@player.FirstName @player.LastName</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_selectedPlayer == null)"
                   OnClick="AddPlayer">Add</MudButton>
    </div>

    @if (_season.Players.Count == 0)
    {
        <MudText Color="Color.Secondary">No players enrolled.</MudText>
    }
    else
    {
        <MudTable Items="_season.Players" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>First Name</MudTh>
                <MudTh>Last Name</MudTh>
                <MudTh>Gender</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.FirstName</MudTd>
                <MudTd>@context.LastName</MudTd>
                <MudTd>@context.Gender</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Color="Color.Error"
                                   Title="Remove" OnClick="@(() => ConfirmRemovePlayer(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudExpansionPanels Class="mt-4" Elevation="2">
        <MudExpansionPanel Text="Match Pool" Expanded="_poolExpanded"
                           ExpandedChanged="OnPoolExpandedChanged">
            @if (_poolLoading)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="mb-2" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="mb-2" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="mb-2" />
            }
            else if (_matchPool == null || _matchPool.TotalCount == 0)
            {
                <MudText Color="Color.Secondary">
                    Not enough players — a season needs at least 4 enrolled players to generate matches.
                </MudText>
            }
            else
            {
                <MudText Class="mb-3">@_matchPool.TotalCount possible matches</MudText>

                <MudTable Items="_matchPool.Matches" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>Team 1</MudTh>
                        <MudTh>Team 2</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Id</MudTd>
                        <MudTd>@FormatTeam(context.Team1)</MudTd>
                        <MudTd>@FormatTeam(context.Team2)</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            }
        </MudExpansionPanel>
    </MudExpansionPanels>

    <div class="d-flex align-center justify-space-between mt-4 mb-2">
        <MudText Typo="Typo.h6">Schedule</MudText>
        <div class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.ClearAll"
                       Disabled="@(_generatingSchedule || !HasPlannedEntries)"
                       OnClick="ConfirmClearAll">
                Clear All
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.EventAvailable"
                       Disabled="@_generatingSchedule" OnClick="GenerateSchedule">
                Generate Schedule
            </MudButton>
        </div>
    </div>

    @if (_generatingSchedule || _scheduleLoading)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="mb-2" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="mb-2" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="mb-2" />
    }
    else if (_schedule == null || _schedule.Entries.Count == 0)
    {
        <MudText Color="Color.Secondary">No matchdays in this period.</MudText>
    }
    else
    {
        <MudTable Items="_schedule.Entries" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Date</MudTh>
                <MudTh>Match</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Date.ToShortDateString()</MudTd>
                <MudTd>
                    @if (context.IsPlanned && context.PlannedMatch != null)
                    {
                        @($"{FormatTeam(context.PlannedMatch.Team1)} vs {FormatTeam(context.PlannedMatch.Team2)}")
                    }
                    else
                    {
                        <span>—</span>
                    }
                </MudTd>
                <MudTd>
                    @if (context.IsPlanned)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Planned</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small">Open</MudChip>
                    }
                </MudTd>
                <MudTd>
                    @if (context.IsPlanned)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Clear" Color="Color.Error"
                                       Size="Size.Small" Title="Clear"
                                       OnClick="@(() => ClearPlannedMatch(context.Date))" />
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private SeasonDto? _season;
    private List<PlayerDto> _allPlayers = [];
    private List<PlayerDto> _availablePlayers = [];
    private PlayerDto? _selectedPlayer;
    private bool _loading = true;

    private bool _poolExpanded;
    private bool _poolLoading;
    private bool _poolLoaded;
    private GenerateMatchesResponse? _matchPool;

    private bool _generatingSchedule;
    private bool _scheduleLoading;
    private SeasonScheduleResponse? _schedule;

    private bool HasPlannedEntries => _schedule?.Entries.Any(e => e.IsPlanned) ?? false;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        try
        {
            var seasonTask = SeasonApi.GetSeasonAsync(Id);
            var playersTask = PlayerApi.GetPlayersAsync();
            await Task.WhenAll(seasonTask, playersTask);
            _season = seasonTask.Result;
            _allPlayers = playersTask.Result;
            RefreshAvailablePlayers();
            await LoadSchedule();
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to load season.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSchedule()
    {
        _scheduleLoading = true;
        try
        {
            _schedule = await SeasonApi.GetScheduleAsync(Id);
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to load schedule.", Severity.Error);
        }
        finally
        {
            _scheduleLoading = false;
        }
    }

    private void RefreshAvailablePlayers()
    {
        if (_season == null) return;
        var enrolledIds = _season.Players.Select(p => p.Id).ToHashSet();
        _availablePlayers = _allPlayers.Where(p => !enrolledIds.Contains(p.Id)).ToList();
        _selectedPlayer = null;
    }

    private async Task AddPlayer()
    {
        if (_selectedPlayer == null) return;
        try
        {
            var result = await SeasonApi.AddPlayerToSeasonAsync(Id, new AddSeasonPlayerRequest(_selectedPlayer.Id));
            if (result != null)
            {
                _season = result;
                RefreshAvailablePlayers();
                Snackbar.Add("Player added.", Severity.Success);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to add player.", Severity.Error);
        }
    }

    private async Task ConfirmRemovePlayer(PlayerDto player)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm Remove",
            $"Remove {player.FirstName} {player.LastName} from this season?",
            yesText: "Remove", cancelText: "Cancel");
        if (confirmed == true)
            await RemovePlayer(player.Id);
    }

    private async Task RemovePlayer(int playerId)
    {
        try
        {
            await SeasonApi.RemovePlayerFromSeasonAsync(Id, playerId);
            _season = await SeasonApi.GetSeasonAsync(Id);
            RefreshAvailablePlayers();
            Snackbar.Add("Player removed.", Severity.Success);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            Snackbar.Add("Cannot remove: season must have at least 4 players.", Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to remove player.", Severity.Error);
        }
    }

    private async Task OnPoolExpandedChanged(bool expanded)
    {
        _poolExpanded = expanded;
        if (!expanded || _poolLoaded) return;
        await LoadMatchPool();
    }

    private async Task LoadMatchPool()
    {
        _poolLoading = true;
        try
        {
            _matchPool = await SeasonApi.GetMatchPoolAsync(Id);
            _poolLoaded = true;
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to load match pool.", Severity.Error);
        }
        finally
        {
            _poolLoading = false;
        }
    }

    private async Task GenerateSchedule()
    {
        _generatingSchedule = true;
        try
        {
            var result = await SeasonApi.GenerateScheduleAsync(Id);
            if (result == null)
            {
                Snackbar.Add("Season not found.", Severity.Error);
                return;
            }

            Snackbar.Add(
                $"Planned {result.PlannedCount} matchdays, {result.OpenCount} still open.",
                Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to generate schedule.", Severity.Error);
        }
        finally
        {
            _generatingSchedule = false;
        }

        await LoadSchedule();
    }

    private async Task ClearPlannedMatch(DateOnly date)
    {
        try
        {
            var cleared = await SeasonApi.ClearPlannedMatchAsync(Id, date);
            if (cleared)
            {
                Snackbar.Add("Planned match cleared.", Severity.Success);
                await LoadSchedule();
            }
            else
            {
                Snackbar.Add("No planned match to clear.", Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to clear planned match.", Severity.Error);
        }
    }

    private async Task ConfirmClearAll()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm Clear All",
            "Clear all planned matches for this season?",
            yesText: "Clear All", cancelText: "Cancel");
        if (confirmed == true)
            await ClearAllPlannedMatches();
    }

    private async Task ClearAllPlannedMatches()
    {
        try
        {
            var cleared = await SeasonApi.ClearAllPlannedMatchesAsync(Id);
            if (cleared)
            {
                Snackbar.Add("All planned matches cleared.", Severity.Success);
                await LoadSchedule();
            }
            else
            {
                Snackbar.Add("Season not found.", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to clear planned matches.", Severity.Error);
        }
    }

    private static string FormatTeam(TeamDto team) =>
        $"{team.Player1.FirstName} {team.Player1.LastName} & " +
        $"{team.Player2.FirstName} {team.Player2.LastName}";
}
